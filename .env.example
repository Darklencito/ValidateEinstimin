JWT_SECRET=tu_secreto_super_seguro_de_al_menos_32_caracteres
ADMIN_USER=admin
# Genera el hash con: npm run hash -- "tu_contraseña"
# IMPORTANTE: en .env.local escapa cada "$" como "\$" (Next.js expande variables)
ADMIN_PASSWORD_HASH=$2a$10$...

# --- Verificación SMTP (capa 3), todo opcional. Ver README ---
# Proxy SOCKS5 para no usar el puerto 25 del hosting (varios separados por coma: se rotan)
# SMTP_PROXIES=socks5://usuario:clave@IP_DEL_VPS:1080
# Dominio del saludo EHLO y remitente de la consulta (mejor uno tuyo con DNS inverso correcto)
# SMTP_HELO_DOMAIN=mail.tudominio.com
# SMTP_MAIL_FROM=verify@tudominio.com
# Pausa entre consultas al mismo dominio en ms (por defecto 700)
# SMTP_DELAY_MS=700
# Tope global de consultas por minuto entre todos los dominios (0 = sin tope). Contabo: usa 20
# SMTP_MAX_PER_MINUTE=20

# --- Capa 4: EmailAwesome (opcional, usa créditos). La clave va SOLO aquí, nunca en el código ---
# EMAILAWESOME_API_KEY=tu_clave

# --- Capa 4 alternativa: emailval (se cobra por uso a fin de mes) ---
# EMAILVAL_API_KEY=tu_clave
# Orden del modo automático (si uno se queda sin créditos continúa con el siguiente)
# VERIFIER_ORDER=emailawesome,emailval
